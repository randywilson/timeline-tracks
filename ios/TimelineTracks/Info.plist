<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Standard keys normally generated by Xcode — must be explicit with a hand-written plist -->
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>Timeline Tracks</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Location -->
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
    </array>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Timeline Tracks requests GPS fixes at regular intervals to keep your device's location hardware active, improving accuracy for Google Timeline and other apps.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Timeline Tracks needs "Always" access to request GPS fixes while the screen is off. This is the core purpose of the app — it does not collect, store, or transmit your location.</string>
    <!-- Required for iOS 10 and earlier; safe to include on all versions. -->
    <key>NSLocationAlwaysUsageDescription</key>
    <string>Timeline Tracks needs "Always" access to request GPS fixes while the screen is off.</string>

    <!-- UI -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <!-- Empty dict = plain white launch screen, generated by the system. -->
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
