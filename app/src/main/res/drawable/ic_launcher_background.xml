<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background layer (108x108dp).
  Colors and horizon position match ic_launcher_foreground exactly:
    Sky blue (#89B9D7) fills top 50% (y=0..54).
    Sandy ground (#B58251) fills bottom 50% (y=54..108).
  This ensures the background extends the icon colors correctly when the
  launcher uses a square or rounded-rect mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sky blue -->
    <path
        android:fillColor="#89B9D7"
        android:pathData="M0,0 L108,0 L108,54 L0,54 Z" />

    <!-- Sandy ground -->
    <path
        android:fillColor="#B58251"
        android:pathData="M0,54 L108,54 L108,108 L0,108 Z" />

</vector>
